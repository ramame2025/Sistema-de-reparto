generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pgBouncer, puerto 6543) para el runtime.
  url       = env("DATABASE_URL")
  // Conexion directa (puerto 5432) que Prisma usa para migraciones y para
  // introspeccion. pgBouncer en modo transaction no soporta prepared
  // statements ni DDL, asi que migrate/deploy NECESITA esta.
  directUrl = env("DIRECT_URL")
}

/// Que exige un medio de pago en materia de comprobante. A diferencia de los
/// medios de pago, esto SI es un enum: los tres estados los entiende el
/// codigo, y agregar un cuarto no es configuracion sino una funcionalidad
/// nueva que hay que programar.
enum ProofPolicy {
  none
  optional
  required
}

enum SaleStatus {
  active
  canceled
}

enum SaleKind {
  sale
  churn
  swap
}

/// Por que volvio una unidad. Enum y no tabla por el mismo criterio que
/// `SaleKind` y `ProofPolicy`: los dos motivos los entiende el codigo, y un
/// tercero seria una funcionalidad nueva que hay que programar, no
/// configuracion del duenio.
enum ReturnReason {
  /// Envase vacio que el cliente devuelve.
  empty
  /// Unidad fallada que se cambio por una nueva.
  faulty
}

enum SaleAuditAction {
  created
  edited
  canceled
}

enum ExpenseCategory {
  combustible
  peaje
  comida
  mantenimiento
  varios
}

enum UserRole {
  admin
  chofer
}

/// titular: el camion es de ese chofer (endDate null mientras siga vigente, o
/// con fecha cuando dejo de serlo). cobertura: dias puntuales en los que otro
/// chofer maneja el camion; SIEMPRE acotada, y pisa al titular en esos dias.
enum AssignmentKind {
  titular
  cobertura
}

model Sale {
  id                String         @id @default(cuid())
  clientGeneratedId String?        @unique
  createdAt         DateTime       @default(now())
  /// Cuando ocurrio la venta en la calle, que no es cuando la fila se
  /// inserto: una venta sin senal se sincroniza mas tarde. Se tarifa por esta
  /// fecha, y es la que evita que una venta de las 23:50 quede contada al dia
  /// siguiente.
  occurredAt        DateTime       @default(now())
  status            SaleStatus     @default(active)
  canceledAt        DateTime?
  cancelReason      String?
  driverName        String         @default("sin-chofer")
  truckCode         String?
  total             Int
  customerName      String
  /// Texto congelado, SIN foreign key a `CustomerCategory`, a proposito. La
  /// venta registra lo que el cliente ERA en ese momento: si la categoria se
  /// renombra o se da de baja despues, esta fila no se tiene que enterar. Con
  /// una FK un `ON UPDATE CASCADE` reescribiria el historial de ventas ya
  /// cobradas, que es exactamente lo que no puede pasar.
  customerType      String
  /// Texto congelado, SIN foreign key a `PaymentMethod`, por la misma razon
  /// que `customerType` justo arriba: la venta registra con que se pago en
  /// ese momento. `null` solo en las filas `kind = churn`, donde no hubo
  /// cobro -- es un hecho de negocio, no un dato faltante.
  paymentMethod     String?
  note              String?
  customerId        String?
  truckId           String?
  kind              SaleKind       @default(sale)
  containerReturned Boolean?
  paymentProofRef   String?
  latitude          Float?
  longitude         Float?
  customer          Customer?      @relation(fields: [customerId], references: [id])
  truck             Truck?         @relation(fields: [truckId], references: [id])
  items             SaleItem[]
  returnItems       SaleReturnItem[]
  audits            SaleAudit[]

  @@index([createdAt])
  @@index([occurredAt])
  @@index([driverName, createdAt])
  @@index([customerId])
  @@index([truckId, createdAt])
  @@index([kind, createdAt])
}

model SaleItem {
  id            String  @id @default(cuid())
  saleId        String
  productCode   String
  quantity      Int
  /// Precio unitario congelado en el momento de la venta. Es el registro
  /// definitivo: ningun cambio de precio posterior, ni una correccion del
  /// historial, puede alterar lo que esta linea cobro.
  unitPrice     Int
  /// `true` cuando la linea es la unidad de REEMPLAZO de un cambio por falla:
  /// salio del camion sin cargo y su espejo es un `SaleReturnItem` con motivo
  /// `faulty`. Sin esta bandera lo vendido y los reemplazos vuelven mezclados
  /// en la misma lista, y una visita mixta -- vendio Y cambio -- deja de ser
  /// editable porque nadie puede volver a partirlos.
  ///
  /// NO es un filtro de stock, y leerla asi seria el error de `SaleReturnItem`
  /// al reves: un reemplazo SALIO del camion y descuenta como cualquier otra
  /// linea. `getTruckStockForDay` sigue sumando TODAS, marcadas o no.
  isReplacement Boolean @default(false)
  sale          Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Restrict, no Cascade: un producto que alguna vez se vendio no se puede
  /// borrar nunca. Se da de baja con isActive.
  product       Product @relation(fields: [productCode], references: [code], onDelete: Restrict)

  @@index([saleId])
  @@index([productCode])
}

/// Lo que VUELVE de la calle: envases vacios y unidades falladas.
///
/// Tabla propia y no una columna sobre `SaleItem`, a proposito. El stock del
/// camion suma TODA linea de `SaleItem` sin filtrar (`getTruckStockForDay`),
/// asi que una unidad que ENTRA anotada ahi se contaria como mercaderia que
/// SALIO y los numeros del chofer dejarian de cerrar contra su remito, en
/// silencio. Una tabla nueva no la puede sumar por accidente una consulta que
/// ya existe: la garantia es estructural y no depende de que cada consulta
/// futura se acuerde de filtrar.
///
/// La unidad de REEMPLAZO de un cambio no vive aca: esa si salio del camion y
/// es un `SaleItem` con `unitPrice` en 0.
model SaleReturnItem {
  id          String       @id @default(cuid())
  saleId      String
  productCode String
  quantity    Int
  reason      ReturnReason
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Restrict, igual que en `SaleItem`: un producto que alguna vez volvio no
  /// se puede borrar del catalogo sin perder el registro de por que volvio.
  product     Product      @relation(fields: [productCode], references: [code], onDelete: Restrict)

  @@index([saleId])
}

model SaleAudit {
  id        String          @id @default(cuid())
  saleId    String
  action    SaleAuditAction
  reason    String
  before    Json?
  after     Json?
  createdAt DateTime        @default(now())
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId, createdAt])
}

model DriverExpense {
  id         String          @id @default(cuid())
  createdAt  DateTime        @default(now())
  driverName String
  category   ExpenseCategory
  amount     Int
  note       String?
  receiptRef String?

  @@index([createdAt])
}

model UserAccount {
  id                  String                     @id @default(cuid())
  username            String                     @unique
  passwordHash        String
  role                UserRole
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  assignments         DriverTruckAssignment[]
  customerAssignments DriverCustomerAssignment[]
}

model Customer {
  id                String                          @id @default(cuid())
  name              String
  /// Codigo de la categoria del cliente. Conserva el nombre de columna que
  /// tenia como enum: ya viaja dentro de los payloads de venta encolados en
  /// los telefonos, igual que `productCode`.
  customerType      String
  zoneId            String?
  /// Human-readable street address. Independent from latitude/longitude:
  /// a customer may have a pin, an address, both, or neither. Nothing
  /// geocodes one into the other.
  address           String?
  latitude          Float?
  longitude         Float?
  isActive          Boolean                         @default(true)
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  sales             Sale[]
  assignmentEntries DriverCustomerAssignmentEntry[]
  /// Restrict, no Cascade: una zona que algun cliente referencia no se puede
  /// borrar nunca. Se da de baja con isActive, igual que un producto.
  zoneRef           Zone?                           @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  /// Restrict, no Cascade: una categoria que algun cliente referencia no se
  /// puede borrar nunca. Se da de baja con isActive.
  category          CustomerCategory                @relation(fields: [customerType], references: [code], onDelete: Restrict)

  @@index([isActive, name])
  @@index([zoneId])
  @@index([customerType])
}

model Truck {
  id            String                  @id @default(cuid())
  code          String                  @unique
  plate         String                  @unique
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  sales         Sale[]
  assignments   DriverTruckAssignment[]
  loadManifests LoadManifest[]
  capacities    TruckCapacity[]

  @@index([isActive, code])
}

/// Cuantas unidades de cada producto entran en el camion. Reemplaza al total
/// unico `Truck.capacity`, que no decia QUE carga entra y no se podia repartir
/// entre productos sin inventar el reparto.
///
/// La ausencia de fila significa "sin detallar", y una fila con `units = 0`
/// significa "este producto no viaja en este camion". Son estados distintos, y
/// por eso el cero se guarda en vez de omitirse.
///
/// Sigue siendo INFORMATIVA: nada valida un remito contra esta grilla.
model TruckCapacity {
  id          String   @id @default(cuid())
  truckId     String
  productCode String
  units       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Cascade, no Restrict: la capacidad es una propiedad DEL camion y no
  /// significa nada sin el. Es la unica relacion del schema donde el borrado
  /// en cascada es lo correcto.
  truck       Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  /// Restrict, como toda referencia a producto en este schema: un producto que
  /// alguien referencia no se borra nunca, se da de baja con isActive.
  product     Product  @relation(fields: [productCode], references: [code], onDelete: Restrict)

  @@unique([truckId, productCode])
  @@index([truckId])
}

model DriverTruckAssignment {
  id        String         @id @default(cuid())
  driverId  String
  truckId   String
  kind      AssignmentKind @default(titular)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime       @default(now())
  driver    UserAccount    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  truck     Truck          @relation(fields: [truckId], references: [id], onDelete: Restrict)

  @@index([truckId, startDate])
  @@index([driverId, startDate])
  @@index([truckId, kind, startDate])
}

/// Un unico row por chofer+dia (parent+items, no rango): la lista se
/// reemplaza entera en cada edicion, nunca se superpone ni se resuelve por
/// especificidad como DriverTruckAssignment.
model DriverCustomerAssignment {
  id        String                          @id @default(cuid())
  driverId  String
  date      DateTime
  createdAt DateTime                        @default(now())
  updatedAt DateTime                        @updatedAt
  driver    UserAccount                     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  entries   DriverCustomerAssignmentEntry[]

  @@unique([driverId, date])
  @@index([driverId, date])
}

model DriverCustomerAssignmentEntry {
  id           String                   @id @default(cuid())
  assignmentId String
  customerId   String
  position     Int                      @default(0)
  assignment   DriverCustomerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, customerId])
  @@index([assignmentId])
  @@index([customerId])
}

model LoadManifest {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  driverName String             @default("sin-chofer")
  truckId    String
  truckCode  String?
  photoRef   String?
  note       String?
  truck      Truck              @relation(fields: [truckId], references: [id])
  items      LoadManifestItem[]

  @@index([createdAt])
  @@index([driverName, createdAt])
  @@index([truckId, createdAt])
}

model LoadManifestItem {
  id          String       @id @default(cuid())
  manifestId  String
  productCode String
  quantity    Int
  manifest    LoadManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productCode], references: [code], onDelete: Restrict)

  @@index([manifestId])
  @@index([productCode])
}

/// Catalogo de productos, editable por el admin. `code` es la clave estable
/// que viaja por la API y que ya esta persistida en los payloads encolados en
/// los telefonos de los choferes, asi que es inmutable una vez creada.
model Product {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  prices          ProductPrice[]
  saleItems       SaleItem[]
  saleReturnItems SaleReturnItem[]
  manifestItems   LoadManifestItem[]
  truckCapacities TruckCapacity[]

  @@index([isActive, sortOrder])
}

/// Zonas de reparto, editables por el admin. `code` es la clave estable e
/// inmutable de la zona, igual que la del producto: el `name` se puede
/// renombrar sin que nada quede colgado.
model Zone {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]

  @@index([isActive, sortOrder])
}

/// Medios de pago (antes el enum `PaymentMethod`). Mismo contrato que
/// `CustomerCategory`: `code` es la clave estable e inmutable que ya viaja
/// dentro de los payloads de venta encolados en los telefonos, asi que se
/// renombra el `name` y nunca el `code`; una fila se retira con `isActive` y
/// no se borra nunca.
///
/// Lo que esta tabla agrega sobre las otras taxonomias son REGLAS, no
/// etiquetas: `proofPolicy` es la que decide si una venta lleva comprobante,
/// y hasta esta migracion vivia como tres comparaciones contra el string
/// 'efectivo' repartidas en tres apps distintas.
///
/// No tiene endpoints de escritura a proposito (ver D3 del plan): una mala
/// configuracion deja a los choferes sin poder cobrar.
model PaymentMethod {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  proofPolicy  ProofPolicy @default(optional)
  /// Si el cobro es plata fisica que el chofer tiene que rendir. Todavia no
  /// lo lee nadie: no hay arqueo en el sistema. Ver D6 del plan.
  countsAsCash Boolean     @default(false)
  /// Si el cliente queda debiendo la venta. Tercera pregunta independiente de
  /// las otras dos banderas: una transferencia no es plata en mano y tampoco
  /// deja deuda. Quien decide, lee esta bandera y nunca compara el `code`
  /// contra 'cuenta_corriente'. Ver D1 y D2 de
  /// `docs/plans/current-account-sales.md`.
  createsDebt  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  /// Sin relacion inversa a `Sale`: la columna de la venta no tiene FK, a
  /// proposito. Ver el comentario en `Sale.paymentMethod`.

  @@index([isActive, sortOrder])
}

/// Categorias de cliente (antes el enum `CustomerType`), editables por el
/// admin. `code` es la clave estable e inmutable que viaja por la API y que
/// ya esta persistida en los payloads de venta encolados en los telefonos,
/// asi que se renombra el `name` y nunca el `code`.
///
/// Una categoria nueva NACE SIN PRECIOS: no se copian los de otra categoria.
/// Un precio heredado miente en silencio; una celda vacia se ve.
model CustomerCategory {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  customers Customer[]
  prices    ProductPrice[]

  @@index([isActive, sortOrder])
}

/// Append-only: cambiar un precio INSERTA una fila nueva, nunca pisa una
/// existente. El precio vigente en una fecha es la fila mas reciente con
/// `validFrom` menor o igual a esa fecha. Sin esto no hay forma de responder
/// "cuanto valia esto el lunes", que es lo que necesita una venta encolada.
/// El historial de quien cambio que precio sale gratis de este mismo diseno.
model ProductPrice {
  id           String           @id @default(cuid())
  productCode  String
  customerType String
  amount       Int
  validFrom    DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productCode], references: [code], onDelete: Restrict)
  /// Restrict, no Cascade: una categoria que alguna vez tuvo un precio no se
  /// puede borrar nunca. Se da de baja con isActive.
  category     CustomerCategory @relation(fields: [customerType], references: [code], onDelete: Restrict)

  @@unique([productCode, customerType, validFrom])
  @@index([productCode, customerType, validFrom])
}
