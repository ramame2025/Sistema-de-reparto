{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/dashboard/Dockerfile",
    "watchPatterns": [
      "apps/dashboard/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "package.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
