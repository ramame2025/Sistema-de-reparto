# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT
# Copy to .env and adjust. For staging/production values see
# docs/deploy/railway-supabase.md — those live in Railway, never in a file.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (local Docker Postgres from docker-compose.yml) ---
# App runtime connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:56321/distribuidor?schema=public"
# Direct connection Prisma uses for migrations. Locally it is the same as
# DATABASE_URL; on Supabase it is the :5432 (non-pooled) URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:56321/distribuidor?schema=public"

# --- API auth ---
JWT_SECRET="dev_secret_change_me"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
DRIVER_USERNAME="chofer"
DRIVER_PASSWORD="chofer123"

# --- Supabase Storage (receipt / manifest photos) ---
# Locally you can point these at a real Supabase project's Storage, or leave
# them unset and simply not exercise the photo-upload flow.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="receipts"

# --- Frontend clients ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"
