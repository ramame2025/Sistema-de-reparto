{
  "name": "distribuidor",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:driver": "pnpm --filter driver-app start",
    "dev:api": "pnpm --filter api start:dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "typescript": "^5.6.3"
  }
}